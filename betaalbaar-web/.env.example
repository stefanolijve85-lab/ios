# Publieke basis-URL (voor canonicals en sitemap). Pas aan zodra het domein is geregistreerd.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Zet pas op "true" wanneer de site echt openbaar mag worden geïndexeerd.
SITE_INDEXABLE=false

# Beheer (/beheer). Zonder beide waarden is het beheerscherm uitgeschakeld.
ADMIN_PASSWORD=
SESSION_SECRET=

# Map voor dossiers en uploads. Moet op een persistente schijf staan.
DATA_DIR=./.data
