# ---------------------------------------------------------------------------
# Civitas environment variables
# Copy to `.env.local` for development. The demo runs fully without any of
# these (it uses the in-memory seed layer); set them to switch to Supabase,
# storage and push notifications.
# ---------------------------------------------------------------------------

# Supabase (auth + Postgres + realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (media storage, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=civitas-media
R2_PUBLIC_URL=

# Web Push (VAPID keys — generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@civitas.example

# OAuth providers (configured in the Supabase dashboard)
# GOOGLE / APPLE client IDs & secrets live in Supabase Auth settings.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
